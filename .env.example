# Secure Distributed Dropbox - Environment Variables Template
# =============================================================================
# IMPORTANT NOTICE:
# All default values below are DEVELOPMENT-ONLY placeholders for local testing.
# NEVER use these default credentials in staging or production deployments.
# In production (ENVIRONMENT=production), the system automatically validates
# and enforces strong, non-default JWT secrets and unique MinIO access keys.
# =============================================================================

# Node Identity Configuration
NODE_ID=node-1
HTTP_PORT=8001
GRPC_PORT=50051

# Peer Nodes (Comma-separated host:port list for gRPC consensus)
# Node 1: node-2:50052,node-3:50053
# Node 2: node-1:50051,node-3:50053
# Node 3: node-1:50051,node-2:50052
RAFT_PEERS=node-2:50052,node-3:50053

# Database & Storage (DEVELOPMENT-ONLY PLACEHOLDERS - REPLACE IN PRODUCTION)
DATABASE_URL=postgresql://dropbox_user:dropbox_password@localhost:5432/dropbox_db
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# Security & Authentication (DEVELOPMENT-ONLY PLACEHOLDER - REPLACE IN PRODUCTION)
# Production requires a cryptographically strong, unique secret key (minimum 32 characters)
JWT_SECRET_KEY=change-this-in-production-super-secret-key-32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Operational Environment & Phase
ENVIRONMENT=development
PHASE=phase-7
LOG_LEVEL=INFO
